# Backend Environment Variables
PORT=5000
NODE_ENV=production
JWT_SECRET=college_paper_tracker_jwt_prod_secret_2026

# Seeded Admin Credentials (provisioned on first launch)
ADMIN_NAME=Institutional Administrator
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=AdminSecurePassword@2026

# MongoDB Connection String (e.g. MongoDB Atlas)
# If left empty, system uses zero-configuration embedded In-Memory MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clg_paper_tracker?retryWrites=true&w=majority
