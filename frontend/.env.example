# Frontend Environment Variables
# For local development, leave empty or point to localhost:
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# For production on Vercel:
# Set VITE_API_URL to your Render backend URL (e.g. https://papertracker-api.onrender.com/api)
# Set VITE_SOCKET_URL to your Render backend base URL (e.g. https://papertracker-api.onrender.com)
